<Window x:Class="StereoSwap.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StereoSwap"
        Height="340" Width="440"
        MinHeight="300" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F3F4F6">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               Text="StereoSwap"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top"
               Text="L↔R channel swap on a selected stereo output (shared mode)."
               TextWrapping="Wrap"
               Foreground="#4B5563"
               Margin="0,0,0,16"/>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="Channel check (tone only on that side)"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6"/>
      <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
        <Button Content="Left" Command="{Binding TestLeftCommand}" Margin="0,0,6,0" Padding="8,8"/>
        <Button Content="Right" Command="{Binding TestRightCommand}" Margin="6,0,0,0" Padding="8,8"/>
      </UniformGrid>
      <Button Content="Refresh devices" Command="{Binding RefreshCommand}" Padding="8,6"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Output device" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice}"
                DisplayMemberPath="Name"
                Margin="0,0,0,14"/>

      <CheckBox Content="L↔R swap enabled"
                IsChecked="{Binding SwapEnabled}"
                Margin="0,0,0,10"/>
      <CheckBox Content="Start with Windows"
                IsChecked="{Binding AutostartEnabled}"/>
    </StackPanel>
  </DockPanel>
</Window>
