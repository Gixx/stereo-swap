<Window x:Class="StereoSwap.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StereoSwap"
        Height="420" Width="460"
        MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="StereoSwap" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="L↔R channel swap on a selected stereo output (shared mode)."
                 TextWrapping="Wrap"
                 Foreground="#4B5563"/>
    </StackPanel>

    <!-- Device + swap options (never covered by status) -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="Output device" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice}"
                DisplayMemberPath="Name"
                Margin="0,0,0,12"/>
      <CheckBox Content="L↔R swap enabled"
                IsChecked="{Binding SwapEnabled}"
                Margin="0,0,0,8"/>
      <CheckBox Content="Start with Windows"
                IsChecked="{Binding AutostartEnabled}"/>
    </StackPanel>

    <!-- Channel check -->
    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="Channel check (tone only on that side)"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6"/>
      <UniformGrid Columns="2" Rows="1">
        <Button Content="Left" Command="{Binding TestLeftCommand}" Margin="0,0,6,0" Padding="8,8"/>
        <Button Content="Right" Command="{Binding TestRightCommand}" Margin="6,0,0,0" Padding="8,8"/>
      </UniformGrid>
    </StackPanel>

    <!-- Status fills remaining space, scrolls if long -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
      <TextBlock Text="{Binding Status}"
                 Foreground="#6B7280"
                 TextWrapping="Wrap"/>
    </ScrollViewer>

    <Button Grid.Row="4"
            Content="Refresh devices"
            Command="{Binding RefreshCommand}"
            Padding="8,6"/>
  </Grid>
</Window>
