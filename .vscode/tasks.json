{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-stereoswap",
            "type": "process",
            "command": "${workspaceFolder}/packaging/kill-stereoswap.cmd",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false,
                "close": true
            }
        },
        {
            "label": "build",
            "dependsOn": ["kill-stereoswap"],
            "dependsOrder": "sequence",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ui/StereoSwap.Tray/StereoSwap.Tray.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/ui/StereoSwap.Tray/StereoSwap.Tray.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/ui/StereoSwap.Tray/StereoSwap.Tray.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
